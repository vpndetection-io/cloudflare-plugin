{
    "name": "vpndetection-cloudflare",
    "version": "1.0.2",
    "description": "Block VPNs, proxies and Tor at Cloudflare's edge, on any plan, with a Worker that checks each visitor against the VPNDetection API.",
    "private": true,
    "type": "module",
    "license": "MIT",
    "homepage": "https://vpndetection.io",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/vpndetection-io/cloudflare-plugin.git"
    },
    "scripts": {
        "build": "wrangler deploy --dry-run --outdir dist",
        "deploy": "wrangler deploy",
        "dev": "wrangler dev",
        "lint": "eslint",
        "typecheck": "tsc --noEmit",
        "test": "npm run build && node --test test/*.test.mjs"
    },
    "cloudflare": {
        "bindings": {
            "VPNDETECTION_API_KEY": {
                "description": "Your VPNDetection API key. Create one for free in the [console](https://app.vpndetection.io)."
            }
        }
    },
    "dependencies": {
        "ip-address": "^10.7.6",
        "vpndetection": "^5.19.2",
        "zod": "^4.6.7"
    },
    "devDependencies": {
        "@cloudflare/workers-types": "^5.20261114.1",
        "@mslmio/eslint-config": "^2.6.1",
        "eslint": "^10.15.0",
        "miniflare": "5.20261113.0-beta",
        "typescript": "^6.0.3",
        "wrangler": "^4.162.0"
    }
}
